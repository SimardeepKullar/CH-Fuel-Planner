{
  "name": "ch-fuel-planner",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/SimardeepKullar/CH-Fuel-Planner#readme",
  "bugs": {
    "url": "https://github.com/SimardeepKullar/CH-Fuel-Planner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimardeepKullar/CH-Fuel-Planner.git"
  },
  "license": "ISC",
  "author": "",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "predev": "docker compose up -d",
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace backend",
    "seed": "npm run seed --workspace backend",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run db:migrate",
    "db:logs": "docker compose logs -f db",
    "typecheck": "npm run typecheck --workspace backend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend",
    "test": "npm run test --workspace backend",
    "test:unit": "npm run test:unit --workspace backend",
    "verify": "npm run typecheck && npm run lint && npm test",
    "prepare": "git config core.hooksPath .githooks"
  }
}
